{
	"targets": [
		{
			"triple": "x86_64-unknown-linux-gnu",
			"runner": "ubuntu-latest",
			"os": "linux",
			"arch": "x64",
			"shell_sh": true,
			"agent": true,
			"hub": false,
			"desktop": false,
			"artifacts": {},
			"enabled": true
		},
		{
			"triple": "aarch64-unknown-linux-gnu",
			"runner": "ubuntu-latest",
			"os": "linux",
			"arch": "arm64",
			"shell_sh": true,
			"agent": true,
			"hub": false,
			"desktop": false,
			"artifacts": {},
			"enabled": true
		},
		{
			"triple": "x86_64-pc-windows-msvc",
			"runner": "windows-latest",
			"os": "windows",
			"arch": "x64",
			"shell_sh": false,
			"agent": true,
			"hub": true,
			"desktop": true,
			"artifacts": {
				"bundles": ["nsis", "msi"],
				"hub": ["lasterm-hub-x86_64-pc-windows-msvc.exe"],
				"desktop": [
					"Lasterm_{version}_x64-setup.exe",
					"Lasterm_{version}_x64_*.msi"
				],
				"msix": ["Lasterm_{version}.*_x64.msix"]
			},
			"enabled": true
		},
		{
			"triple": "aarch64-apple-darwin",
			"runner": "macos-latest",
			"os": "macos",
			"arch": "arm64",
			"shell_sh": true,
			"agent": true,
			"hub": true,
			"desktop": true,
			"enabled": false
		}
	]
}
