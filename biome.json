{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": ["**/server.js", "**/server"],
								"message": "A hub serves only through startHub, which takes the hub lock before it builds anything; only hub-startup.ts uses server.ts. A spec builds a hub through server.fixture.ts."
							},
							{
								"group": ["**/*.fixture.js", "**/*.fixture"],
								"message": "Fixtures are test-only: the production build leaves them out, and server.fixture.ts builds a hub without its lock."
							}
						]
					}
				}
			}
		}
	},
	"overrides": [
		{
			"includes": ["packages/clients/desktop/src-tauri/tauri.conf.json"],
			"formatter": {
				"enabled": false
			}
		},
		{
			"includes": ["packages/clients/web/src/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedGlobals": {
							"level": "error",
							"options": {
								"deniedGlobals": {
									"fetch": "Use hubFetch: direct webview requests can bypass the pinned desktop relay."
								}
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/*.spec.ts"],
			"linter": {
				"rules": {
					"style": {
						"noNonNullAssertion": "off",
						"noRestrictedGlobals": "off"
					}
				}
			}
		},
		{
			"includes": ["packages/clients/web/src/utils/hub-fetch.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedGlobals": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.spec.ts", "**/*.fixture.ts", "**/*.setup.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/server.js", "**/server"],
										"importNamePattern": "(createServer|startServer)",
										"message": "A spec builds a hub through server.fixture.ts, the one door that skips the hub lock."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/hub/src/hub-startup.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/*.fixture.js", "**/*.fixture"],
										"message": "Fixtures are test-only: the production build leaves them out."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/hub/src/server.fixture.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		}
	],
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"files": {
		"includes": [
			"**/packages/**/*.ts",
			"**/packages/**/*.tsx",
			"**/*.ts",
			"**/*.json",
			"!**/node_modules",
			"!**/dist",
			"!**/.turbo",
			"!**/coverage",
			"!**/target"
		]
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "all"
		}
	}
}
