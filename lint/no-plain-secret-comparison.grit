language js

// A token, secret, password or passphrase compared with `===`, `!==`, `==` or
// `!=` leaks, through how long the comparison takes, how much of a guess was
// right (#514). Compare secrets with tokensEqual from packages/hub/src/auth.ts.
// Either side counts when it is a name or a member chain ending in such a name
// and the other side is a name or a member chain too, not a constant.
or {
	`$left === $right`,
	`$left !== $right`,
	`$left == $right`,
	`$left != $right`
} as $comparison where {
	or {
		and {
			$left <: r"(?i)^(?:[\w$]+\??\.)*[\w$]*(?:token|secret|password|passphrase)$",
			$right <: r"^[\w$]+(?:\??\.[\w$]+)*$",
			not $right <: r"^(?:null|undefined|true|false|\d+)$"
		},
		and {
			$right <: r"(?i)^(?:[\w$]+\??\.)*[\w$]*(?:token|secret|password|passphrase)$",
			$left <: r"^[\w$]+(?:\??\.[\w$]+)*$",
			not $left <: r"^(?:null|undefined|true|false|\d+)$"
		}
	},
	register_diagnostic(
		span = $comparison,
		message = "A secret compared with a plain equality leaks how much of a guess was right: use tokensEqual from auth.ts (#514)."
	)
}
