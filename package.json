{
	"name": "lasterm",
	"version": "0.9.1",
	"private": true,
	"type": "module",
	"description": "Local-first session terminal platform — hub daemon + agent + SSH + PWA UI",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/khiops/lasterm.git"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"bin": {
		"lasterm": "./bin/lasterm.js"
	},
	"files": [
		"bin",
		"LICENSE"
	],
	"scripts": {
		"dev": "concurrently -n hub,web -c blue,green \"pnpm -F @lasterm/hub dev\" \"pnpm -F @lasterm/web dev\"",
		"build": "pnpm -r build",
		"build:embed": "pnpm -F @lasterm/web build && node scripts/embed-web.js",
		"build:test-tls-material": "tsx scripts/build-test-tls-material.ts",
		"test": "vitest",
		"test:run": "vitest run",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "pnpm -r typecheck",
		"build:sea-hub": "tsx scripts/build-sea-hub.ts",
		"package:sea-hub": "tsx scripts/package-sea-hub.ts",
		"build:desktop": "bash scripts/build-desktop.sh"
	},
	"dependencies": {
		"@lasterm/hub": "workspace:*"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"concurrently": "catalog:",
		"esbuild": "catalog:",
		"happy-dom": "catalog:",
		"postject": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"packageManager": "pnpm@11.22.0"
}
