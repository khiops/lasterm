{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Lasterm",
	"identifier": "app.lasterm.desktop",
	"version": "0.9.0",
	"build": {
		"devUrl": "http://localhost:5173",
		"frontendDist": "../../web/dist",
		"beforeDevCommand": "",
		"beforeBuildCommand": ""
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"create": false,
				"title": "Lasterm",
				"width": 1280,
				"height": 800,
				"minWidth": 800,
				"minHeight": 600,
				"resizable": true,
				"fullscreen": false,
				"decorations": false,
				"transparent": true,
				"visible": false
			}
		],
		"macOSPrivateApi": true,
		"security": {
			"csp": {
				"default-src": ["'none'"],
				"script-src": ["'self'"],
				"style-src": ["'self'", "'unsafe-inline'"],
				"connect-src": ["ipc:", "http://ipc.localhost"],
				"img-src": ["'self'", "data:", "blob:"],
				"font-src": ["'self'", "data:", "blob:"],
				"media-src": ["blob:"],
				"worker-src": ["'none'"],
				"base-uri": ["'none'"],
				"form-action": ["'none'"],
				"frame-ancestors": ["'none'"]
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"externalBin": [
			"lasterm-hub",
			"lasterm-agent"
		],
		"createUpdaterArtifacts": false,
		"resources": {},
		"shortDescription": "Local-first session terminal platform",
		"category": "DeveloperTool",
		"copyright": "© 2026 Lasterm contributors",
		"licenseFile": "../../../../LICENSE",
		"windows": {
			"nsis": {
				"installMode": "both",
				"installerIcon": "icons/icon.ico",
				"headerImage": null,
				"sidebarImage": null,
				"template": "windows/installer.nsi"
			}
		}
	},
	"plugins": {
		"updater": {
			"endpoints": [
				"https://github.com/khiops/lasterm/releases/latest/download/latest.json"
			],
			"dialog": true,
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwRTI3QUYwRDI1MjgxNUUKUldSZWdWTFM4SHJpc0ZjcVR5UXdGSDUwK3RpZmRiZlRFZzJRUTd4SFNTekkwVnpLQ2hEYWJTdkQK"
		},
		"shell": {
			"open": false
		}
	}
}
