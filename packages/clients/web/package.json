{
	"name": "@lasterm/web",
	"version": "0.9.0",
	"description": "lasterm web client \u2014 Vue 3 PWA (not published; embedded in hub static dir)",
	"private": true,
	"license": "AGPL-3.0-only",
	"type": "module",
	"scripts": {
		"build": "vue-tsc -p tsconfig.json --noEmit && vite build",
		"dev": "vite",
		"test": "pnpm -w exec vitest run --project web",
		"typecheck": "vue-tsc -p tsconfig.json --noEmit && tsc -p tsconfig.typecheck.json"
	},
	"dependencies": {
		"@lasterm/shared": "workspace:*",
		"@msgpack/msgpack": "catalog:",
		"@tauri-apps/api": "catalog:",
		"@tauri-apps/plugin-os": "catalog:",
		"@xterm/addon-fit": "catalog:",
		"@xterm/addon-search": "catalog:",
		"@xterm/addon-unicode11": "catalog:",
		"@xterm/xterm": "catalog:",
		"pinia": "catalog:",
		"vue": "catalog:"
	},
	"devDependencies": {
		"@vitejs/plugin-vue": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vue-tsc": "catalog:"
	}
}
