{
	"name": "@lasterm/hub",
	"private": true,
	"version": "0.9.0",
	"description": "lasterm hub — Fastify daemon, session management, SSH transport, REST + WebSocket API",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/khiops/lasterm.git"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"type": "module",
	"files": [
		"dist",
		"src/storage/migrations",
		"LICENSE"
	],
	"exports": {
		".": "./dist/index.js",
		"./cli": "./dist/cli.js"
	},
	"scripts": {
		"dev": "tsx watch src/main.ts",
		"build": "tsc -p tsconfig.json && node -e \"fs.cpSync('src/storage/migrations','dist/storage/migrations',{recursive:true})\"",
		"test": "pnpm -w run build:test-tls-material && pnpm -w exec vitest run --project hub",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@fastify/cors": "catalog:",
		"@fastify/helmet": "catalog:",
		"@fastify/multipart": "catalog:",
		"@fastify/static": "catalog:",
		"@fastify/websocket": "catalog:",
		"@iarna/toml": "catalog:",
		"@msgpack/msgpack": "catalog:",
		"@lasterm/shared": "workspace:*",
		"@rainbowatcher/toml-edit-js": "catalog:",
		"better-sqlite3": "catalog:",
		"fastify": "catalog:",
		"file-type": "catalog:",
		"ssh2": "catalog:"
	},
	"devDependencies": {
		"@types/better-sqlite3": "catalog:",
		"@types/node": "catalog:",
		"@types/ssh2": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:"
	}
}
