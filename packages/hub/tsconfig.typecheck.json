{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"types": ["node"]
	},
	// Every spec is checked, so a new one is too (#214). The repository's
	// scripts have their own config, scripts/tsconfig.json (#531).
	"include": ["src/**/*.spec.ts", "src/**/*.fixture.ts", "src/**/*.setup.ts"],
	"exclude": ["node_modules", "dist"]
}
