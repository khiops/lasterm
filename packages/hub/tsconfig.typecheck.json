{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"types": ["node"],
		"paths": {
			"fastify": ["./node_modules/fastify/fastify.d.ts"]
		}
	},
	// Every spec is checked, so a new one is too (#214).
	"include": ["src/**/*.spec.ts", "src/**/*.fixture.ts", "src/**/*.setup.ts", "../../scripts/**/*"],
	"exclude": ["node_modules", "dist"]
}
